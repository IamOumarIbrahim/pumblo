{
  "name": "pumblo",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Shareable film pages for AI motion creators, with the process and feedback attached.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/*.test.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test && npm run audit:prod && npm run build",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.49.0",
    "@cloudflare/workers-types": "5.20260731.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.32",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "wrangler": "4.116.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
